# --- Database ---
# SQLite for local dev. To move to Postgres: change provider in
# prisma/schema.prisma to "postgresql" and set this to your PG connection string.
DATABASE_URL="file:./dev.db"

# --- Admin auth (CMS dashboard) ---
# Session JWT signing secret. CHANGE THIS in production.
AUTH_SECRET="change-me-to-a-long-random-secret-min-32-chars"

# --- Media storage ---
# Local disk now; swap to S3/R2 base URL later.
UPLOAD_DIR="./public/uploads"
