# =============================================================================
# Status Daily CMS — environment
# Copy to .env for local dev. In production (Vercel) set these in the dashboard.
# =============================================================================

# --- Database ---
# LOCAL DEV: SQLite (default). PRODUCTION: Neon Postgres connection string.
# When moving to Neon: also flip `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Admin auth (CMS dashboard) ---
# Session JWT signing secret. Use a long random value in production.
AUTH_SECRET="change-me-to-a-long-random-secret-min-32-chars"

# --- Media storage ---
# Leave the R2_* vars BLANK for local dev → files save to ./public/uploads.
# Fill them in to store media in Cloudflare R2 (images auto-converted to WebP).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL of the bucket (r2.dev URL or custom domain), no trailing slash.
R2_PUBLIC_URL=""

# Legacy local-dir hint (used only by the disk fallback).
UPLOAD_DIR="./public/uploads"
